import pandas as pd

from .data_cleaning import clean_time_index
from .alignment import to_monthly_last, lag_features
from .returns import simple_returns, forward_returns
from .transforms import rolling_zscore, rolling_percentile_rank


class MasterDatasetBuilder:
    """
    Build a clean master research dataset from market, macro,
    positioning, and flow data.
    """

    def __init__(self, frequency: str = "M"):
        self.frequency = frequency
        self.datasets = {}

    def add_dataset(self, name: str, df: pd.DataFrame | pd.Series):
        df = clean_time_index(df)
        self.datasets[name] = df
        return self

    def resample(self, df: pd.DataFrame | pd.Series):
        if self.frequency == "M":
            return df.resample("M").last()
        elif self.frequency == "W":
            return df.resample("W-FRI").last()
        else:
            raise ValueError("frequency must be 'M' or 'W'")

    def build_panel(self):
        aligned = []

        for name, df in self.datasets.items():
            resampled = self.resample(df)

            if isinstance(resampled, pd.Series):
                resampled = resampled.to_frame(name)

            aligned.append(resampled.add_prefix(f"{name}_"))

        return pd.concat(aligned, axis=1)

    def build_features(
        self,
        zscore_window: int = 36,
        percentile_window: int = 60
    ):
        panel = self.build_panel()

        features = pd.concat([
            panel,
            rolling_zscore(panel, window=zscore_window).add_suffix("_z"),
            rolling_percentile_rank(panel, window=percentile_window).add_suffix("_pct")
        ], axis=1)

        return features

    def build_model_dataset(
        self,
        target: pd.Series,
        lag: int = 1,
        zscore_window: int = 36,
        percentile_window: int = 60,
        dropna: bool = True
    ):
        features = self.build_features(
            zscore_window=zscore_window,
            percentile_window=percentile_window
        )

        X = lag_features(features, periods=lag)

        dataset = pd.concat([X, target], axis=1)

        if dropna:
            dataset = dataset.dropna()

        return dataset


