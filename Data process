import numpy as np
import pandas as pd


def simple_returns(prices: pd.DataFrame | pd.Series) -> pd.DataFrame | pd.Series:
    """Calculate simple returns from prices."""
    return prices.pct_change()


def log_returns(prices: pd.DataFrame | pd.Series) -> pd.DataFrame | pd.Series:
    """Calculate log returns from prices."""
    return np.log(prices / prices.shift(1))


def cumulative_returns(returns: pd.Series | pd.DataFrame) -> pd.Series | pd.DataFrame:
    """Convert periodic simple returns into cumulative wealth index."""
    return (1 + returns).cumprod()


def forward_returns(
    returns: pd.Series,
    horizon: int = 1,
    name: str | None = None
) -> pd.Series:
    """
    Create forward compounded simple return target.

    Example:
    horizon=3 means next 3-period return.
    """
    fwd = (
        (1 + returns)
        .rolling(horizon)
        .apply(np.prod, raw=True)
        .shift(-horizon)
        - 1
    )

    if name:
        fwd.name = name
    else:
        fwd.name = f"{returns.name}_fwd_{horizon}"

    return fwd

