import numpy as np
import pandas as pd


def rolling_zscore(
    x: pd.Series | pd.DataFrame,
    window: int = 36,
    min_periods: int | None = None
):
    """Rolling z-score."""
    if min_periods is None:
        min_periods = window

    mean = x.rolling(window, min_periods=min_periods).mean()
    std = x.rolling(window, min_periods=min_periods).std()

    return (x - mean) / std


def rolling_percentile_rank(
    x: pd.Series | pd.DataFrame,
    window: int = 60,
    min_periods: int | None = None
):
    """Rolling percentile rank of latest observation."""

    if min_periods is None:
        min_periods = window

    def pct_rank(arr):
        s = pd.Series(arr)
        return s.rank(pct=True).iloc[-1]

    return x.rolling(window, min_periods=min_periods).apply(pct_rank, raw=False)


def yoy_change(x: pd.Series | pd.DataFrame, periods: int = 12):
    """Year-over-year percentage change."""
    return x.pct_change(periods)


def period_change(x: pd.Series | pd.DataFrame, periods: int = 1):
    """Absolute change over period."""
    return x.diff(periods)


def percent_change(x: pd.Series | pd.DataFrame, periods: int = 1):
    """Percentage change over period."""
    return x.pct_change(periods)


def moving_average_gap(
    x: pd.Series | pd.DataFrame,
    window: int = 12
):
    """Current value minus rolling average."""
    return x - x.rolling(window).mean()


def rolling_sum(
    x: pd.Series | pd.DataFrame,
    window: int = 4
):
    """Rolling sum, useful for flows."""
    return x.rolling(window).sum()


def net_position(
    longs: pd.Series,
    shorts: pd.Series
):
    """Net positioning: longs minus shorts."""
    return longs - shorts


def net_position_ratio(
    longs: pd.Series,
    shorts: pd.Series
):
    """
    Normalized net positioning:
    (longs - shorts) / (longs + shorts)
    """
    denominator = longs + shorts
    return (longs - shorts) / denominator.replace(0, np.nan)


