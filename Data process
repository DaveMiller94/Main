import pandas as pd


def to_monthly_last(df: pd.DataFrame | pd.Series):
    """Convert to month-end observations."""
    return df.resample("M").last()


def to_weekly_last(df: pd.DataFrame | pd.Series):
    """Convert to Friday weekly observations."""
    return df.resample("W-FRI").last()


def daily_prices_to_monthly_returns(prices: pd.DataFrame | pd.Series):
    """Convert daily prices to monthly simple returns."""
    monthly_prices = prices.resample("M").last()
    return monthly_prices.pct_change()


def align_to_monthly(
    datasets: dict[str, pd.DataFrame | pd.Series],
    method: str = "last"
):
    """
    Align multiple datasets to monthly frequency.

    datasets:
        {"spx": spx_df, "macro": macro_df, ...}

    method:
        "last" or "mean"
    """
    aligned = []

    for name, df in datasets.items():
        df = df.copy()

        if method == "last":
            resampled = df.resample("M").last()
        elif method == "mean":
            resampled = df.resample("M").mean()
        else:
            raise ValueError("method must be 'last' or 'mean'")

        if isinstance(resampled, pd.Series):
            resampled = resampled.to_frame(name)

        aligned.append(resampled.add_prefix(f"{name}_"))

    return pd.concat(aligned, axis=1)


def lag_features(
    features: pd.DataFrame,
    periods: int = 1
):
    """Lag features to avoid lookahead bias."""
    return features.shift(periods)


def merge_features_and_target(
    features: pd.DataFrame,
    target: pd.Series,
    lag_features_by: int = 1,
    dropna: bool = True
):
    """Lag features and merge with target."""
    X = features.shift(lag_features_by)
    y = target.copy()

    dataset = pd.concat([X, y], axis=1)

    if dropna:
        dataset = dataset.dropna()

    return dataset


