import pandas as pd


def check_datetime_index(df: pd.DataFrame | pd.Series):
    """Check whether index is datetime."""
    return isinstance(df.index, pd.DatetimeIndex)


def check_sorted_index(df: pd.DataFrame | pd.Series):
    """Check whether index is sorted."""
    return df.index.is_monotonic_increasing


def check_duplicate_dates(df: pd.DataFrame | pd.Series):
    """Return duplicate dates."""
    return df.index[df.index.duplicated()].unique()


def missing_summary(df: pd.DataFrame):
    """Summarize missing values."""
    return pd.DataFrame({
        "missing_count": df.isna().sum(),
        "missing_pct": df.isna().mean()
    }).sort_values("missing_pct", ascending=False)


def data_quality_report(df: pd.DataFrame):
    """Basic data quality report."""
    return {
        "datetime_index": check_datetime_index(df),
        "sorted_index": check_sorted_index(df),
        "duplicate_dates": list(check_duplicate_dates(df)),
        "start_date": df.index.min(),
        "end_date": df.index.max(),
        "rows": len(df),
        "columns": len(df.columns),
        "missing": missing_summary(df)
    }




