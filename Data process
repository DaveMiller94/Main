import pandas as pd


def ensure_datetime_index(df: pd.DataFrame | pd.Series):
    """Ensure index is datetime and sorted."""
    df = df.copy()
    df.index = pd.to_datetime(df.index)
    df = df.sort_index()
    return df


def remove_duplicate_dates(df: pd.DataFrame | pd.Series):
    """Remove duplicate index values, keeping the last observation."""
    return df[~df.index.duplicated(keep="last")]


def clean_time_index(df: pd.DataFrame | pd.Series):
    """Standard time-index cleaning."""
    df = ensure_datetime_index(df)
    df = remove_duplicate_dates(df)
    return df


def drop_invalid_prices(prices: pd.DataFrame | pd.Series):
    """Remove non-positive prices."""
    return prices.where(prices > 0)


def winsorize(
    x: pd.Series | pd.DataFrame,
    lower_q: float = 0.01,
    upper_q: float = 0.99
):
    """Winsorize extreme values column-by-column."""
    lower = x.quantile(lower_q)
    upper = x.quantile(upper_q)
    return x.clip(lower=lower, upper=upper, axis=1 if isinstance(x, pd.DataFrame) else 0)


def safe_ffill(
    df: pd.DataFrame | pd.Series,
    limit: int | None = None
):
    """Forward-fill missing values with optional limit."""
    return df.ffill(limit=limit)

