from sklearn.pipeline import Pipeline
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import Ridge
from sklearn.model_selection import TimeSeriesSplit
from sklearn.metrics import mean_squared_error

def walk_forward_model_score(X, y, model=None, n_splits=5):
    """
    Walk-forward regression score.
    """

    if model is None:
        model = Pipeline([
            ("scaler", StandardScaler()),
            ("model", Ridge(alpha=10))
        ])

    temp = pd.concat([X, y], axis=1).dropna()
    X_clean = temp[X.columns]
    y_clean = temp[y.name]

    tscv = TimeSeriesSplit(n_splits=n_splits)

    preds = pd.Series(index=y_clean.index, dtype=float)

    for train_idx, test_idx in tscv.split(X_clean):
        X_train = X_clean.iloc[train_idx]
        X_test = X_clean.iloc[test_idx]
        y_train = y_clean.iloc[train_idx]

        model.fit(X_train, y_train)
        preds.iloc[test_idx] = model.predict(X_test)

    mse = mean_squared_error(y_clean.loc[preds.dropna().index], preds.dropna())
    corr = y_clean.loc[preds.dropna().index].corr(preds.dropna())

    return {
        "mse": mse,
        "forecast_corr": corr,
        "predictions": preds
    }

