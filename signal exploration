def trailing_return(asset_returns, window=3):
    return (
        (1 + asset_returns)
        .rolling(window)
        .apply(np.prod, raw=True)
        - 1
    ).rename(f"trailing_return_{window}")

trailing_3m = trailing_return(asset_returns, window=3)


def test_positioning_reversal(
    positioning_pct,
    trailing_returns,
    forward_returns,
    crowded_threshold=0.9,
    underowned_threshold=0.1
):
    """
    Tests whether crowded/underowned positioning predicts reversals.

    Crowded reversal:
        positioning > 90th percentile and trailing return > 0

    Underowned rebound:
        positioning < 10th percentile and trailing return < 0
    """

    rows = []

    for col in positioning_pct.columns:
        temp = pd.concat(
            [
                positioning_pct[col],
                trailing_returns,
                forward_returns
            ],
            axis=1
        ).dropna()

        temp.columns = ["positioning", "trailing_return", "forward_return"]

        if len(temp) < 60:
            continue

        crowded_long = (
            (temp["positioning"] >= crowded_threshold) &
            (temp["trailing_return"] > 0)
        )

        underowned_weak = (
            (temp["positioning"] <= underowned_threshold) &
            (temp["trailing_return"] < 0)
        )

        normal = ~(crowded_long | underowned_weak)

        crowded_forward_return = temp.loc[crowded_long, "forward_return"].mean()
        underowned_forward_return = temp.loc[underowned_weak, "forward_return"].mean()
        normal_forward_return = temp.loc[normal, "forward_return"].mean()

        rows.append({
            "signal": col,
            "crowded_forward_return": crowded_forward_return,
            "underowned_forward_return": underowned_forward_return,
            "normal_forward_return": normal_forward_return,
            "crowded_minus_normal": crowded_forward_return - normal_forward_return,
            "underowned_minus_normal": underowned_forward_return - normal_forward_return,
            "crowded_obs": crowded_long.sum(),
            "underowned_obs": underowned_weak.sum(),
            "normal_obs": normal.sum()
        })

    return pd.DataFrame(rows)


