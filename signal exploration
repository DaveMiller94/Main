def test_forward_return_prediction(X, y, n_quantiles=5):
    """
    Tests each positioning signal against forward returns.

    Returns:
        IC, quantile spread, top/bottom quantile returns.
    """

    rows = []

    for col in X.columns:
        temp = pd.concat([X[col], y], axis=1).dropna()
        temp.columns = ["signal", "target"]

        if len(temp) < 60:
            continue

        if temp["signal"].nunique() < n_quantiles:
            continue

        temp["quantile"] = pd.qcut(
            temp["signal"],
            q=n_quantiles,
            labels=False,
            duplicates="drop"
        )

        q_returns = temp.groupby("quantile")["target"].mean()

        if len(q_returns) < 2:
            continue

        ic = temp["signal"].corr(temp["target"])

        rows.append({
            "signal": col,
            "ic": ic,
            "top_quantile_return": q_returns.iloc[-1],
            "bottom_quantile_return": q_returns.iloc[0],
            "top_minus_bottom": q_returns.iloc[-1] - q_returns.iloc[0],
            "abs_spread": abs(q_returns.iloc[-1] - q_returns.iloc[0]),
            "observations": len(temp)
        })

    return (
        pd.DataFrame(rows)
        .sort_values("abs_spread", ascending=False)
        .reset_index(drop=True)
    )

