def create_forward_drawdown_target(asset_returns, horizon=3):
    """
    Forward max drawdown over the next horizon.
    """

    def max_drawdown(x):
        wealth = np.cumprod(1 + x)
        peak = np.maximum.accumulate(wealth)
        dd = wealth / peak - 1
        return dd.min()

    fwd_dd = (
        asset_returns
        .rolling(horizon)
        .apply(max_drawdown, raw=True)
        .shift(-horizon)
    )

    return fwd_dd.rename(f"fwd_drawdown_{horizon}")

