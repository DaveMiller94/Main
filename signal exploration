def test_directional_accuracy(X, y):
    """
    Tests whether high/low signal values predict positive future returns.

    Uses simple median split.
    """

    rows = []

    y_direction = (y > 0).astype(int)

    for col in X.columns:
        temp = pd.concat([X[col], y_direction], axis=1).dropna()
        temp.columns = ["signal", "direction"]

        if len(temp) < 60:
            continue

        median_signal = temp["signal"].median()

        temp["high_signal"] = temp["signal"] > median_signal

        hit_rate_high = temp.loc[temp["high_signal"], "direction"].mean()
        hit_rate_low = temp.loc[~temp["high_signal"], "direction"].mean()

        rows.append({
            "signal": col,
            "hit_rate_high_signal": hit_rate_high,
            "hit_rate_low_signal": hit_rate_low,
            "hit_rate_spread": hit_rate_high - hit_rate_low,
            "abs_hit_rate_spread": abs(hit_rate_high - hit_rate_low),
            "observations": len(temp)
        })

    return (
        pd.DataFrame(rows)
        .sort_values("abs_hit_rate_spread", ascending=False)
        .reset_index(drop=True)
    )

