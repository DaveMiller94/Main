def create_forward_volatility_target(asset_returns, horizon=3):
    """
    Forward realized volatility over horizon.
    """

    fwd_vol = (
        asset_returns
        .rolling(horizon)
        .std()
        .shift(-horizon)
    )

    return fwd_vol.rename(f"fwd_vol_{horizon}")

