def remove_correlated_signals(ranked_signals, signal_df, max_corr=0.75, max_signals=10):
    selected = []

    for signal in ranked_signals["signal"]:
        if signal not in signal_df.columns:
            continue

        if len(selected) == 0:
            selected.append(signal)
            continue

        corr_with_selected = signal_df[selected + [signal]].corr()[signal].drop(signal)

        if corr_with_selected.abs().max() < max_corr:
            selected.append(signal)

        if len(selected) >= max_signals:
            break

    return selected


