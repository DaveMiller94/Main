import numpy as np
import pandas as pd

def create_forward_return_target(asset_returns, horizon=1):
    """
    Creates forward compounded return over a given horizon.

    asset_returns:
        Periodic return series, e.g. daily, weekly, or monthly returns.

    horizon:
        Number of periods ahead.
    """

    fwd_return = (
        (1 + asset_returns)
        .rolling(horizon)
        .apply(np.prod, raw=True)
        .shift(-horizon)
        - 1
    )

    return fwd_return.rename(f"fwd_return_{horizon}")



