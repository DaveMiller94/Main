def add_selection_score(summary):
    df = summary.copy()

    def rank_abs(series):
        return series.abs().rank(pct=True)

    df["return_score"] = rank_abs(df["top_minus_bottom"])
    df["direction_score"] = rank_abs(df["hit_rate_spread"])
    df["reversal_score"] = rank_abs(df["crowded_minus_normal"])
    df["risk_score"] = rank_abs(df["drawdown_top_minus_bottom"])
    df["incremental_score"] = df["delta_corr"].rank(pct=True)

    df["selection_score"] = (
        0.25 * df["return_score"] +
        0.15 * df["direction_score"] +
        0.25 * df["reversal_score"] +
        0.15 * df["risk_score"] +
        0.20 * df["incremental_score"]
    )

    return df.sort_values("selection_score", ascending=False)




