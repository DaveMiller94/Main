def rolling_zscore(df, window=36):
    return (df - df.rolling(window).mean()) / df.rolling(window).std()

def rolling_percentile_rank(df, window=60):
    def pct_rank(x):
        return pd.Series(x).rank(pct=True).iloc[-1]

    return df.rolling(window).apply(pct_rank, raw=False)

