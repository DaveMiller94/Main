def test_incremental_positioning_value(
    base_features,
    positioning_features,
    y,
    n_splits=5
):
    rows = []

    base_score = walk_forward_model_score(
        base_features,
        y,
        n_splits=n_splits
    )

    base_corr = base_score["forecast_corr"]
    base_mse = base_score["mse"]

    for col in positioning_features.columns:
        X_augmented = pd.concat(
            [
                base_features,
                positioning_features[[col]]
            ],
            axis=1
        )

        score = walk_forward_model_score(
            X_augmented,
            y,
            n_splits=n_splits
        )

        rows.append({
            "signal": col,
            "base_corr": base_corr,
            "augmented_corr": score["forecast_corr"],
            "delta_corr": score["forecast_corr"] - base_corr,
            "base_mse": base_mse,
            "augmented_mse": score["mse"],
            "delta_mse": score["mse"] - base_mse
        })

    return (
        pd.DataFrame(rows)
        .sort_values("delta_corr", ascending=False)
        .reset_index(drop=True)
    )

