def combine_positioning_tests(
    return_results,
    direction_results,
    reversal_results,
    vol_results,
    drawdown_results,
    incremental_results
):
    result = return_results[[
        "signal",
        "ic",
        "top_minus_bottom",
        "abs_spread"
    ]].copy()

    result = result.merge(
        direction_results[[
            "signal",
            "hit_rate_spread",
            "abs_hit_rate_spread"
        ]],
        on="signal",
        how="left"
    )

    result = result.merge(
        reversal_results[[
            "signal",
            "crowded_minus_normal",
            "underowned_minus_normal",
            "crowded_obs",
            "underowned_obs"
        ]],
        on="signal",
        how="left"
    )

    result = result.merge(
        vol_results[[
            "signal",
            "top_minus_bottom"
        ]].rename(columns={
            "top_minus_bottom": "vol_top_minus_bottom"
        }),
        on="signal",
        how="left"
    )

    result = result.merge(
        drawdown_results[[
            "signal",
            "top_minus_bottom"
        ]].rename(columns={
            "top_minus_bottom": "drawdown_top_minus_bottom"
        }),
        on="signal",
        how="left"
    )

    result = result.merge(
        incremental_results[[
            "signal",
            "delta_corr",
            "delta_mse"
        ]],
        on="signal",
        how="left"
    )

    return result

